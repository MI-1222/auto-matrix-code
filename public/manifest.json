{
  "manifest_version": 3,
  "name": "Auto Matrix Code",
  "version": "1.2.0",
  "permissions": [
    "activeTab", 
    "scripting", 
    "nativeMessaging"
  ],
  "commands": {
    "run-automation": {
      "suggested_key": {
        "default": "Ctrl+M",
        "mac": "Command+M"
      },
      "description": "東工大ポータルの自動入力コマンド"
    }
  },
  "background": {
    "service_worker": "background.js" 
  }
}
